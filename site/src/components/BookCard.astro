---
import type { Lang } from "../i18n/ui"

interface Props {
	lang: Lang
	title: string
	subtitle?: string
	year?: string
	kind?: string
	status?: string
	cover?: string
	link?: string
	body?: string
}
const { title, subtitle, year, kind, status, cover, link, body } = Astro.props
const Tag = link ? "a" : "div"
---

<Tag
	href={link}
	target={link ? "_blank" : undefined}
	rel={link ? "noopener noreferrer" : undefined}
	class="reveal card card-hover group flex gap-5 p-5 transition-transform duration-300 hover:-translate-y-1"
>
	{
		cover ? (
			<img
				src={cover}
				alt=""
				loading="lazy"
				decoding="async"
				width="120"
				height="170"
				class="h-[150px] w-[104px] shrink-0 rounded-xl border border-line object-cover"
			/>
		) : (
			<div class="grid h-[150px] w-[104px] shrink-0 place-items-center rounded-xl border border-line bg-raised/60 text-2xl">
				📖
			</div>
		)
	}
	<div class="min-w-0 flex-1">
		<div class="flex flex-wrap items-center gap-2 text-xs text-muted">
			{kind && <span class="chip">{kind}</span>}
			{year && <span>{year}</span>}
			{status && <span>· {status}</span>}
		</div>
		<h3 class="mt-2 font-display text-base font-bold transition-colors group-hover:text-accent">{title}</h3>
		{subtitle && <p class="mt-1 text-sm text-muted">{subtitle}</p>}
		{body && <p class="mt-3 line-clamp-4 text-sm leading-7 text-muted">{body}</p>}
	</div>
</Tag>
