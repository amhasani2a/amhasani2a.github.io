---
interface Props {
	id?: string
	eyebrow?: string
	title: string
	subtitle?: string
	href?: string
	hrefLabel?: string
}
const { id, eyebrow, title, subtitle, href, hrefLabel } = Astro.props
---

<section id={id} class="py-16 md:py-24">
	<div class="wrap">
		<div class="reveal mb-8 flex flex-wrap items-end justify-between gap-4 md:mb-12">
			<div class="max-w-prose">
				{eyebrow && <p class="eyebrow mb-2">{eyebrow}</p>}
				<h2 class="h-section">{title}</h2>
				{subtitle && <p class="mt-2 text-muted">{subtitle}</p>}
			</div>
			{
				href && hrefLabel && (
					<a href={href} class="btn text-muted hover:text-ink">
						{hrefLabel}
						<span aria-hidden="true">→</span>
					</a>
				)
			}
		</div>
		<slot />
	</div>
</section>
