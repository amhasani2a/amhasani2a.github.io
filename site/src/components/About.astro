---
import { t, type Lang } from "../i18n/ui"
import profileFa from "../data/profile.fa.json"
import profileEn from "../data/profile.en.json"

interface Props {
	lang: Lang
}
const { lang } = Astro.props
const tr = t(lang)
const profile = lang === "en" ? profileEn : profileFa
---

<div class="grid grid-cols-1 gap-6 lg:grid-cols-[1.3fr_1fr]">
	<div class="reveal card p-6 md:p-8">
		{profile.bio.map((p) => <p class="mb-4 max-w-prose text-[15px] leading-8 text-muted last:mb-0">{p}</p>)}
		{
			profile.resumeUrl && (
				<a href={profile.resumeUrl} class="btn mt-6" target="_blank" rel="noopener noreferrer">
					{lang === "fa" ? "دانلود رزومه (PDF)" : "Download resume (PDF)"}
				</a>
			)
		}
	</div>

	<div class="reveal card p-6 md:p-8">
		<h3 class="eyebrow mb-4">{tr("section.skills")}</h3>
		<div class="space-y-5">
			{
				profile.skills.map((group) => (
					<div>
						<p class="mb-2 text-sm font-medium">{group.group}</p>
						<div class="flex flex-wrap gap-2">
							{group.items.map((item) => (
								<span class="chip">{item}</span>
							))}
						</div>
					</div>
				))
			}
		</div>
	</div>
</div>
