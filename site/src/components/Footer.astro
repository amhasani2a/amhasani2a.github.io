---
import { t, localePath, type Lang } from "../i18n/ui"
import settings from "../data/settings.json"
import profileFa from "../data/profile.fa.json"
import profileEn from "../data/profile.en.json"

interface Props {
	lang: Lang
}
const { lang } = Astro.props
const tr = t(lang)
const profile = lang === "en" ? profileEn : profileFa
const year = new Date().getFullYear()
---

<footer class="mt-24 border-t border-line py-10">
	<div class="wrap flex flex-col items-center justify-between gap-6 md:flex-row">
		<p class="text-sm text-muted">© {year} {profile.name} — {tr("footer.rights")}</p>
		<div class="flex flex-wrap items-center justify-center gap-2">
			{
				settings.social.map((s) => (
					<a
						href={s.url}
						target="_blank"
						rel="noopener noreferrer me"
						class="rounded-xl border border-line px-3 py-2 text-xs text-muted transition-colors hover:border-accent/50 hover:text-ink"
					>
						{s.label}
					</a>
				))
			}
			<a
				href={`${import.meta.env.BASE_URL}rss.xml`}
				class="rounded-xl border border-line px-3 py-2 text-xs text-muted transition-colors hover:border-accent/50 hover:text-ink"
				>RSS</a
			>
			<a
				href={localePath(lang, "/blog")}
				class="rounded-xl border border-line px-3 py-2 text-xs text-muted transition-colors hover:border-accent/50 hover:text-ink"
				>{tr("nav.blog")}</a
			>
		</div>
	</div>
</footer>
