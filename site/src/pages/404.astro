---
import Base from "../layouts/Base.astro"
import { t, localePath, type Lang } from "../i18n/ui"

const lang: Lang = "fa"
const tr = t(lang)
---

<Base lang={lang} title={tr("404.title")}>
	<div class="wrap grid min-h-[60vh] place-items-center py-20 text-center">
		<div>
			<p class="eyebrow">404</p>
			<h1 class="mt-3 font-display text-3xl font-bold md:text-5xl">{tr("404.title")}</h1>
			<p class="mt-4 text-muted">{tr("404.text")}</p>
			<a href={localePath(lang, "/")} class="btn btn-primary mt-8">{tr("nav.home")}</a>
		</div>
	</div>
</Base>
