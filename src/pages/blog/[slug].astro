---
import Base from "../../layouts/Base.astro"
import { t, localePath, formatDate, type Lang } from "../../i18n/ui"
import { getPosts, cleanSlug, readingMinutes } from "../../lib/content"

export async function getStaticPaths() {
	const posts = await getPosts("fa")
	return posts.map((post) => ({ params: { slug: cleanSlug(post.slug) }, props: { post } }))
}

const lang: Lang = "fa"
const tr = t(lang)
const { post } = Astro.props
const { Content } = await post.render()
---

<Base lang={lang} path={`/blog/${cleanSlug(post.slug)}`} title={post.data.title} description={post.data.description}>
	<article class="wrap py-16 md:py-24">
		<a href={localePath(lang, "/blog")} class="text-sm text-muted hover:text-ink">← {tr("nav.blog")}</a>
		<header class="mx-auto mt-6 max-w-prose">
			<div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted">
				<time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, lang)}</time>
				<span>· {readingMinutes(post.body)} {tr("blog.min")}</span>
			</div>
			<h1 class="serif mt-4 text-3xl font-semibold leading-tight md:text-[42px]">{post.data.title}</h1>
			{post.data.description && <p class="mt-4 text-lg text-muted">{post.data.description}</p>}
			{
				post.data.tags.length > 0 && (
					<div class="mt-5 flex flex-wrap gap-2">
						{post.data.tags.map((tag: string) => (
							<span class="chip">#{tag}</span>
						))}
					</div>
				)
			}
		</header>
		{
			post.data.cover && (
				<img
					src={post.data.cover}
					alt=""
					loading="lazy"
					decoding="async"
					class="mx-auto mt-10 w-full max-w-3xl rounded-xl border border-line object-cover"
				/>
			)
		}
		<div class="prose prose-invert mx-auto mt-12 max-w-prose prose-a:text-accent">
			<Content />
		</div>
	</article>
</Base>
