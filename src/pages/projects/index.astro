---
import Base from "../../layouts/Base.astro"
import FeaturedProjects from "../../components/FeaturedProjects.astro"
import Repos from "../../components/Repos.astro"
import { t, type Lang } from "../../i18n/ui"

const lang: Lang = "fa"
const tr = t(lang)
---

<Base lang={lang} path="/projects" title={tr("nav.projects")}>
	<div class="wrap py-16 md:py-24">
		<p class="reveal eyebrow mb-3">{tr("nav.projects")}</p>
		<h1 class="reveal h-display">{tr("section.projects")}</h1>
		<p class="reveal lede mt-5">{tr("projects.subtitle")}</p>
		<div class="mt-10">
			<FeaturedProjects lang={lang} />
			<Repos lang={lang} limit={30} />
		</div>
	</div>
</Base>
