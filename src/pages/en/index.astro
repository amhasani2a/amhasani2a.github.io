---
import Base from "../../layouts/Base.astro"
import Hero from "../../components/Hero.astro"
import Section from "../../components/Section.astro"
import About from "../../components/About.astro"
import Experience from "../../components/Experience.astro"
import FeaturedProjects from "../../components/FeaturedProjects.astro"
import Repos from "../../components/Repos.astro"
import PostCard from "../../components/PostCard.astro"
import ArticleCard from "../../components/ArticleCard.astro"
import Contact from "../../components/Contact.astro"
import { t, localePath, type Lang } from "../../i18n/ui"
import { getPosts, cleanSlug, readingMinutes } from "../../lib/content"
import { getArticles } from "../../lib/articles"

const lang: Lang = "en"
const tr = t(lang)
const posts = (await getPosts(lang)).slice(0, 3)
const articles = (await getArticles(6)).slice(0, 3)
---

<Base lang={lang} path="/">
	<Hero lang={lang} />

	<Section id="about" eyebrow="01" title={tr("section.about")}>
		<About lang={lang} />
	</Section>

	<Section id="resume" eyebrow="02" title={tr("section.resume")}>
		<Experience lang={lang} />
	</Section>

	<Section
		id="projects"
		eyebrow="03"
		title={tr("section.projects")}
		subtitle={tr("projects.subtitle")}
		href={localePath(lang, "/projects")}
		hrefLabel={tr("cta.viewAll")}
	>
		<FeaturedProjects lang={lang} />
		<Repos lang={lang} limit={6} />
	</Section>

	<Section
		id="articles"
		eyebrow="04"
		title={tr("section.articles")}
		subtitle={tr("articles.subtitle")}
		href={localePath(lang, "/articles")}
		hrefLabel={tr("cta.viewAll")}
	>
		{
			articles.length ? (
				<div class="grid-cards">
					{articles.map((article) => (
						<ArticleCard
							lang={lang}
							title={article.title}
							link={article.link}
							date={article.date}
							excerpt={article.excerpt}
							image={article.image}
							categories={article.categories}
						/>
					))}
				</div>
			) : (
				<p class="text-sm text-muted">{tr("articles.empty")}</p>
			)
		}
	</Section>

	<Section
		id="blog"
		eyebrow="05"
		title={tr("section.blog")}
		href={localePath(lang, "/blog")}
		hrefLabel={tr("cta.viewAll")}
	>
		{
			posts.length ? (
				<div class="grid-cards">
					{posts.map((post) => (
						<PostCard
							lang={lang}
							slug={cleanSlug(post.slug)}
							title={post.data.title}
							description={post.data.description}
							date={post.data.date}
							tags={post.data.tags}
							cover={post.data.cover}
							minutes={readingMinutes(post.body)}
						/>
					))}
				</div>
			) : (
				<p class="text-sm text-muted">{tr("blog.empty")}</p>
			)
		}
	</Section>

	<Section id="contact" eyebrow="06" title={tr("section.contact")}>
		<Contact lang={lang} />
	</Section>
</Base>
