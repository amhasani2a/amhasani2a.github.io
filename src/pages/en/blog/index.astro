---
import Base from "../../../layouts/Base.astro"
import PostCard from "../../../components/PostCard.astro"
import { t, type Lang } from "../../../i18n/ui"
import { getPosts, cleanSlug, readingMinutes } from "../../../lib/content"

const lang: Lang = "en"
const tr = t(lang)
const posts = await getPosts(lang)
---

<Base lang={lang} path="/blog" title={tr("nav.blog")}>
	<div class="wrap py-16 md:py-24">
		<p class="reveal eyebrow mb-3">{tr("nav.blog")}</p>
		<h1 class="reveal h-display">{tr("section.blog")}</h1>

		<div class="grid-cards mt-12">
			{
				posts.map((post) => (
					<PostCard
						lang={lang}
						slug={cleanSlug(post.slug)}
						title={post.data.title}
						description={post.data.description}
						date={post.data.date}
						tags={post.data.tags}
						cover={post.data.cover}
						minutes={readingMinutes(post.body)}
					/>
				))
			}
		</div>
		{!posts.length && <p class="mt-10 text-sm text-muted">{tr("blog.empty")}</p>}
	</div>
</Base>
