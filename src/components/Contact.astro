---
import { t, type Lang } from "../i18n/ui"
import settings from "../data/settings.json"
import profileFa from "../data/profile.fa.json"
import profileEn from "../data/profile.en.json"

interface Props {
	lang: Lang
}
const { lang } = Astro.props
const tr = t(lang)
const profile = lang === "en" ? profileEn : profileFa
const hasNewsletter = Boolean(settings.newsletterAction)
---

<div class={hasNewsletter ? "grid-split" : ""}>
	<div class="reveal panel p-7 md:p-10">
		<div class="flex flex-col justify-between gap-8 md:flex-row md:items-end">
			<div>
				<h3 class="serif text-2xl font-semibold">{lang === "fa" ? "پیام مستقیم" : "Direct message"}</h3>
				<p class="mt-4 max-w-[52ch] text-sm leading-8 text-muted">{profile.contactText}</p>
				<div class="mt-7 flex flex-wrap items-center gap-3">
					<a href={`mailto:${settings.email}`} class="mono link-underline text-lg text-ink" dir="ltr"
						>{settings.email}</a
					>
					<button
						type="button"
						class="chip chip-filter"
						data-copy-email={settings.email}
						data-copied={lang === "fa" ? "کپی شد ✓" : "Copied ✓"}
					>
						{lang === "fa" ? "کپی ایمیل" : "Copy"}
					</button>
				</div>
			</div>
			<div class="flex flex-wrap gap-3">
				{
					settings.social.map((s) => (
						<a href={s.url} target="_blank" rel="noopener noreferrer" class="btn">
							{s.label} ↗
						</a>
					))
				}
			</div>
		</div>
	</div>

	{
		hasNewsletter && (
			<div class="reveal card p-7 md:p-10">
				<h3 class="serif text-xl font-semibold">{lang === "fa" ? "خبرنامه" : "Newsletter"}</h3>
				<p class="mt-4 max-w-[46ch] text-sm leading-8 text-muted">{profile.newsletterText}</p>
				<form
					class="mt-7 flex flex-col gap-3 sm:flex-row"
					action={settings.newsletterAction}
					method="post"
					target="_blank"
				>
					<label class="sr-only" for="newsletter-email">
						{tr("newsletter.placeholder")}
					</label>
					<input
						id="newsletter-email"
						name="email"
						type="email"
						required
						placeholder={tr("newsletter.placeholder")}
						class="field"
					/>
					<button type="submit" class="btn btn-primary">
						{tr("newsletter.button")}
					</button>
				</form>
			</div>
		)
	}
</div>

<script>
	document.querySelectorAll<HTMLButtonElement>("[data-copy-email]").forEach((btn) => {
		btn.addEventListener("click", async () => {
			const email = btn.dataset.copyEmail || ""
			if (!email) return
			try {
				await navigator.clipboard.writeText(email)
				const prev = btn.textContent
				btn.textContent = btn.dataset.copied || "Copied"
				btn.setAttribute("aria-pressed", "true")
				setTimeout(() => {
					btn.textContent = prev
					btn.removeAttribute("aria-pressed")
				}, 1800)
			} catch (e) {}
		})
	})
</script>
