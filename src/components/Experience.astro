---
import type { Lang } from "../i18n/ui"
import profileFa from "../data/profile.fa.json"
import profileEn from "../data/profile.en.json"

interface Props {
	lang: Lang
}
const { lang } = Astro.props
const profile = lang === "en" ? profileEn : profileFa
---

<ol class="timeline">
	{
		profile.experience.map((job, i) => (
			<li class="reveal timeline-item">
				<div class="flex items-center gap-3">
					<span class="section-index">{String(i + 1).padStart(2, "0")}</span>
					<span class="timeline-period">{job.period}</span>
				</div>
				<div>
					<h3 class="timeline-title">{job.title}</h3>
					<p class="timeline-org mt-1">{job.org}</p>
					<p class="timeline-text">{job.description}</p>
				</div>
			</li>
		))
	}
</ol>
