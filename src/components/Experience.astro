---
import type { Lang } from "../i18n/ui"
import profileFa from "../data/profile.fa.json"
import profileEn from "../data/profile.en.json"

interface Props {
	lang: Lang
}
const { lang } = Astro.props
const profile = lang === "en" ? profileEn : profileFa
---

<ol class="relative space-y-4">
	{
		profile.experience.map((job) => (
			<li class="reveal card card-hover p-6 transition-transform duration-300 hover:-translate-y-0.5">
				<div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
					<h3 class="font-display text-base font-bold">{job.title}</h3>
					<span class="text-xs text-muted">{job.period}</span>
				</div>
				<p class="mt-1 text-sm text-accent">{job.org}</p>
				<p class="mt-3 max-w-prose text-sm leading-7 text-muted">{job.description}</p>
			</li>
		))
	}
</ol>
