---
import { t, localePath, type Lang } from "../i18n/ui"
import profileFa from "../data/profile.fa.json"
import profileEn from "../data/profile.en.json"

interface Props {
	lang: Lang
	path?: string
}
const { lang, path = "/" } = Astro.props
const tr = t(lang)
const profile = lang === "en" ? profileEn : profileFa
const other: Lang = lang === "fa" ? "en" : "fa"

const nav = [
	{ href: localePath(lang, "/#about"), label: tr("nav.about") },
	{ href: localePath(lang, "/#resume"), label: tr("nav.resume") },
	{ href: localePath(lang, "/projects"), label: tr("nav.projects") },
	{ href: localePath(lang, "/blog"), label: tr("nav.blog") },
	{ href: localePath(lang, "/articles"), label: tr("nav.articles") },
	{ href: localePath(lang, "/#contact"), label: tr("nav.contact") },
]
const initials = profile.name.trim().charAt(0)
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-canvas/80 backdrop-blur-md">
	<div class="wrap flex h-16 items-center justify-between gap-4">
		<a href={localePath(lang, "/")} class="flex items-center gap-2.5 font-display text-sm font-bold">
			<span
				class="grid h-8 w-8 place-items-center rounded-xl bg-accent text-[13px] font-bold text-white"
				aria-hidden="true">{initials}</span
			>
			<span class="hidden sm:inline">{profile.name}</span>
		</a>

		<nav class="hidden items-center gap-1 md:flex" aria-label="Main">
			{
				nav.map((item) => (
					<a
						href={item.href}
						class="rounded-xl px-3 py-2 text-sm text-muted transition-colors duration-200 hover:bg-raised hover:text-ink"
					>
						{item.label}
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-2">
			<a
				href={localePath(other, path)}
				class="rounded-xl border border-line px-3 py-2 text-xs font-medium text-muted transition-colors hover:border-accent/50 hover:text-ink"
				hreflang={other}
				aria-label={other === "en" ? "Switch to English" : "تغییر به فارسی"}
				>{other === "en" ? "EN" : "FA"}</a
			>
			<button
				type="button"
				data-theme-toggle
				class="grid h-10 w-10 place-items-center rounded-xl border border-line text-muted transition-colors hover:border-accent/50 hover:text-ink"
				aria-label={tr("theme")}
				title={tr("theme")}
			>
				<svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
					<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" stroke-linejoin="round"></path>
				</svg>
			</button>
			<button
				type="button"
				data-menu-toggle
				class="grid h-10 w-10 place-items-center rounded-xl border border-line text-muted md:hidden"
				aria-label="Menu"
				aria-expanded="false"
			>
				<svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
					<path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
				</svg>
			</button>
		</div>
	</div>

	<div data-mobile-menu class="hidden border-t border-line bg-canvas md:hidden">
		<nav class="wrap flex flex-col py-3" aria-label="Mobile">
			{
				nav.map((item) => (
					<a href={item.href} class="rounded-xl px-3 py-3 text-sm text-muted hover:bg-raised hover:text-ink">
						{item.label}
					</a>
				))
			}
		</nav>
	</div>
</header>

<script>
	const toggle = document.querySelector("[data-menu-toggle]")
	const menu = document.querySelector("[data-mobile-menu]")
	toggle?.addEventListener("click", () => {
		const open = menu?.classList.toggle("hidden") === false
		toggle.setAttribute("aria-expanded", String(open))
	})
	menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => menu.classList.add("hidden")))
</script>
