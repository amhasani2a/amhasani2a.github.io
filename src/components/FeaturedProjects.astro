---
import settings from "../data/settings.json"
import { t, type Lang } from "../i18n/ui"

interface Props {
	lang: Lang
}
const { lang } = Astro.props
const tr = t(lang)
const items = settings.featuredProjects ?? []
---

{
	items.length > 0 && (
		<div class="mb-8 grid grid-cols-1 gap-4">
			{items.map((item) => (
				<a
					href={item.url}
					target="_blank"
					rel="noopener noreferrer"
					class="reveal card card-hover group flex flex-col gap-3 p-6 transition-transform duration-300 hover:-translate-y-1"
				>
					<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
						<span class="chip">{tr("projects.featured")}</span>
						<h3 class="font-display text-lg font-bold transition-colors group-hover:text-accent">{item.name}</h3>
						<span class="text-xs text-muted" dir="ltr">
							{item.label}
						</span>
					</div>
					<p class="max-w-prose text-sm leading-7 text-muted">
						{lang === "en" ? item.descriptionEn : item.descriptionFa}
					</p>
					<div class="flex flex-wrap gap-2">
						{item.tags.map((tag) => (
							<span class="chip" dir="ltr">
								{tag}
							</span>
						))}
					</div>
				</a>
			))}
		</div>
	)
}
