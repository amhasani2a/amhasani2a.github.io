---
import settings from "../data/settings.json"
import { t, type Lang } from "../i18n/ui"

interface Props {
	lang: Lang
}
const { lang } = Astro.props
const tr = t(lang)
const items = settings.featuredProjects ?? []
---

{
	items.length > 0 && (
		<div class="mb-6 grid gap-4">
			{items.map((item) => (
				<a
					href={item.url}
					target="_blank"
					rel="noopener noreferrer"
					class="reveal card card-hover card-rule group grid gap-6 p-7 md:grid-cols-[1fr_auto] md:items-center md:p-9"
				>
					<div>
						<div class="flex flex-wrap items-center gap-3">
							<span class="chip chip-accent">{tr("projects.featured")}</span>
							<span class="mono text-xs text-muted" dir="ltr">
								{item.label}
							</span>
						</div>
						<h3 class="serif mt-4 text-2xl font-semibold transition-colors group-hover:text-accent">{item.name}</h3>
						<p class="mt-3 max-w-[60ch] text-sm leading-8 text-muted">
							{lang === "en" ? item.descriptionEn : item.descriptionFa}
						</p>
						<div class="mt-5 flex flex-wrap gap-2">
							{item.tags.map((tag) => (
								<span class="chip" dir="ltr">
									{tag}
								</span>
							))}
						</div>
					</div>
					<span class="icon-btn h-12 w-12 shrink-0 rounded-full text-lg" aria-hidden="true">
						↗
					</span>
				</a>
			))}
		</div>
	)
}
