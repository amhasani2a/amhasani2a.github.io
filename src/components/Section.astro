---
interface Props {
	id?: string
	eyebrow?: string
	title: string
	subtitle?: string
	href?: string
	hrefLabel?: string
	index?: string
}
const { id, eyebrow, title, subtitle, href, hrefLabel, index } = Astro.props
---

<section id={id} class="section">
	<div class="wrap">
		<div class="reveal section-head">
			<div class="max-w-[54ch]">
				{(index || eyebrow) && <p class="section-index mb-3">{index ? index + " ——" : eyebrow}</p>}
				<h2 class="h-section">{title}</h2>
				{subtitle && <p class="mt-3 text-sm text-muted">{subtitle}</p>}
			</div>
			{
				href && hrefLabel && (
					<a href={href} class="btn btn-ghost">
						{hrefLabel}
						<span aria-hidden="true">→</span>
					</a>
				)
			}
		</div>
		<slot />
	</div>
</section>
