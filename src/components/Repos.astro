---
import settings from "../data/settings.json"
import { t, type Lang } from "../i18n/ui"

interface Props {
	lang: Lang
	limit?: number
}
const { lang, limit = settings.maxRepos } = Astro.props
const tr = t(lang)
const user = settings.githubUsername
---

<div
	data-repos
	data-user={user}
	data-limit={String(limit)}
	data-pinned={JSON.stringify(settings.pinnedRepos)}
	data-lang={lang}
	data-label-stars={tr("projects.stars")}
	data-label-updated={tr("projects.updated")}
	data-label-error={tr("projects.error")}
	class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3"
>
	{
		Array.from({ length: Math.min(limit, 6) }).map(() => (
			<div class="card h-[168px] p-5" aria-hidden="true">
				<div class="skeleton h-4 w-1/2 rounded" />
				<div class="skeleton mt-4 h-3 w-full rounded" />
				<div class="skeleton mt-2 h-3 w-4/5 rounded" />
				<div class="skeleton mt-6 h-3 w-1/3 rounded" />
			</div>
		))
	}
</div>

<script>
	type Repo = {
		name: string
		html_url: string
		description: string | null
		language: string | null
		stargazers_count: number
		forks_count: number
		pushed_at: string
		fork: boolean
		archived: boolean
		topics?: string[]
		homepage?: string | null
	}

	const CACHE_KEY = "gh-repos-cache-v1"
	const CACHE_TTL = 1000 * 60 * 60 // 1 hour

	const LANG_COLORS: Record<string, string> = {
		Python: "#5E9FE8",
		JavaScript: "#EAC26B",
		TypeScript: "#4FB9C9",
		PHP: "#BF8EDA",
		HTML: "#DE9255",
		CSS: "#72BC8F",
		Shell: "#DF84A8",
		Astro: "#E97366",
	}

	function esc(value: unknown) {
		return String(value ?? "").replace(
			/[&<>"']/g,
			(c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c] as string,
		)
	}

	async function fetchRepos(user: string): Promise<Repo[]> {
		try {
			const cached = JSON.parse(localStorage.getItem(CACHE_KEY) || "null")
			if (cached && cached.user === user && Date.now() - cached.time < CACHE_TTL) return cached.data
		} catch (e) {}

		const endpoint = "https://" + "api.github.com/users/" + user + "/repos?per_page=100&sort=pushed"
		const res = await fetch(endpoint, {
			headers: { Accept: "application/vnd.github+json" },
		})
		if (!res.ok) throw new Error("github error " + res.status)
		const data = (await res.json()) as Repo[]
		try {
			localStorage.setItem(CACHE_KEY, JSON.stringify({ user, time: Date.now(), data }))
		} catch (e) {}
		return data
	}

	function card(repo: Repo, labels: { stars: string; updated: string }, locale: string) {
		const color = (repo.language && LANG_COLORS[repo.language]) || "#7D7A75"
		const updated = new Intl.DateTimeFormat(locale, { year: "numeric", month: "short", day: "numeric" }).format(
			new Date(repo.pushed_at),
		)
		return `
		<a href="${esc(repo.html_url)}" target="_blank" rel="noopener noreferrer"
			class="card card-hover group flex h-full flex-col p-5 transition-transform duration-300 hover:-translate-y-1">
			<div class="flex items-start justify-between gap-3">
				<h3 class="font-display text-base font-bold group-hover:text-accent transition-colors">${esc(repo.name)}</h3>
				<span class="text-xs text-muted whitespace-nowrap">★ ${repo.stargazers_count}</span>
			</div>
			<p class="mt-3 line-clamp-3 flex-1 text-sm text-muted">${esc(repo.description || "")}</p>
			<div class="mt-5 flex items-center justify-between gap-3 text-xs text-muted">
				<span class="inline-flex items-center gap-2">
					${repo.language ? `<span class="h-2.5 w-2.5 rounded-full" style="background:${color}"></span>${esc(repo.language)}` : ""}
				</span>
				<span>${esc(labels.updated)}: ${esc(updated)}</span>
			</div>
		</a>`
	}

	async function render(root: HTMLElement) {
		const user = root.dataset.user!
		const limit = Number(root.dataset.limit || 9)
		const pinned: string[] = JSON.parse(root.dataset.pinned || "[]")
		const locale = root.dataset.lang === "fa" ? "fa-IR" : "en-US"
		const labels = { stars: root.dataset.labelStars!, updated: root.dataset.labelUpdated! }

		try {
			const all = await fetchRepos(user)
			const visible = all.filter((r) => !r.fork && !r.archived)
			const sorted = visible.sort((a, b) => {
				const pa = pinned.indexOf(a.name)
				const pb = pinned.indexOf(b.name)
				if (pa !== -1 || pb !== -1) return (pa === -1 ? 99 : pa) - (pb === -1 ? 99 : pb)
				if (b.stargazers_count !== a.stargazers_count) return b.stargazers_count - a.stargazers_count
				return new Date(b.pushed_at).getTime() - new Date(a.pushed_at).getTime()
			})
			const list = sorted.slice(0, limit)
			root.innerHTML = list.length
				? list.map((r) => card(r, labels, locale)).join("")
				: `<p class="text-sm text-muted">${root.dataset.labelError}</p>`
		} catch (err) {
			root.innerHTML = `<div class="card p-5 text-sm text-muted sm:col-span-2 lg:col-span-3">
				${root.dataset.labelError}
				<a class="text-accent underline" target="_blank" rel="noopener" href="https://github.com/${user}">github.com/${user}</a>
			</div>`
		}
	}

	document.querySelectorAll<HTMLElement>("[data-repos]").forEach((root) => {
		// lazy: only fetch when the section approaches the viewport
		const io = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return
					io.disconnect()
					render(root)
				})
			},
			{ rootMargin: "320px" },
		)
		io.observe(root)
	})
</script>
