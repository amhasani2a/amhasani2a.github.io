---
import { t, type Lang } from "../i18n/ui"
import profileFa from "../data/profile.fa.json"
import profileEn from "../data/profile.en.json"

interface Props {
	lang: Lang
}
const { lang } = Astro.props
const tr = t(lang)
const profile = lang === "en" ? profileEn : profileFa
---

<div class="grid-split">
	<div class="reveal">
		{
			profile.bio.map((p, i) =>
				i === 0 ? (
					<p class="serif mb-6 max-w-[60ch] text-[19px] leading-[1.95] text-ink">{p}</p>
				) : (
					<p class="mb-6 max-w-[62ch] text-[15px] leading-[1.95] text-muted last:mb-0">{p}</p>
				)
			)
		}
		{
			profile.resumeUrl && (
				<a href={profile.resumeUrl} class="btn mt-8" target="_blank" rel="noopener noreferrer">
					{lang === "fa" ? "دانلود رزومه (PDF)" : "Download resume (PDF)"}
				</a>
			)
		}
	</div>

	<div class="reveal panel p-7 md:p-8">
		<h3 class="eyebrow mb-6">{tr("section.skills")}</h3>
		<div class="space-y-6">
			{
				profile.skills.map((group) => (
					<div>
						<p class="mb-3 flex items-center gap-3 text-sm font-medium">
							<span class="h-px w-6 bg-accent" aria-hidden="true" />
							{group.group}
						</p>
						<div class="flex flex-wrap gap-2">
							{group.items.map((item) => (
								<span class="chip">{item}</span>
							))}
						</div>
					</div>
				))
			}
		</div>
	</div>
</div>
