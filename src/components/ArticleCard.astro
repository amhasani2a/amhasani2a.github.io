---
import { formatDate, type Lang } from "../i18n/ui"

interface Props {
	lang: Lang
	title: string
	link: string
	date: Date
	excerpt?: string
	image?: string
	categories?: string[]
}
const { lang, title, link, date, excerpt, image, categories = [] } = Astro.props
---

<article class="reveal card card-hover card-rule group h-full overflow-hidden">
	<a href={link} target="_blank" rel="noopener noreferrer" class="flex h-full flex-col">
		{
			image ? (
				<img
					src={image}
					alt=""
					loading="lazy"
					decoding="async"
					width="640"
					height="360"
					referrerpolicy="no-referrer"
					class="card-media"
				/>
			) : (
				<div class="card-media-fallback" aria-hidden="true">
					Aa
				</div>
			)
		}
		<div class="flex flex-1 flex-col p-6">
			<div class="mono flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] text-muted">
				<time datetime={date.toISOString()}>{formatDate(date, lang)}</time>
			</div>
			<h3 class="serif mt-3 text-lg font-semibold leading-8 transition-colors group-hover:text-accent">{title}</h3>
			{excerpt && <p class="clamp-3 mt-2 flex-1 text-sm leading-7 text-muted">{excerpt}</p>}
			{
				categories.length > 0 && (
					<div class="mt-5 flex flex-wrap gap-2">
						{categories.slice(0, 3).map((category) => (
							<span class="chip">{category}</span>
						))}
					</div>
				)
			}
		</div>
	</a>
</article>
