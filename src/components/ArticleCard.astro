---
import { formatDate, type Lang } from "../i18n/ui"

interface Props {
	lang: Lang
	title: string
	link: string
	date: Date
	excerpt?: string
	image?: string
	categories?: string[]
}
const { lang, title, link, date, excerpt, image, categories = [] } = Astro.props
---

<article class="reveal card card-hover group overflow-hidden transition-transform duration-300 hover:-translate-y-1">
	<a href={link} target="_blank" rel="noopener noreferrer" class="flex h-full flex-col">
		{
			image ? (
				<img
					src={image}
					alt=""
					loading="lazy"
					decoding="async"
					width="640"
					height="360"
					referrerpolicy="no-referrer"
					class="h-44 w-full border-b border-line bg-raised/60 object-cover transition-transform duration-500 group-hover:scale-[1.03]"
				/>
			) : (
				<div
					class="grid h-44 w-full place-items-center border-b border-line bg-raised/60 text-3xl"
					aria-hidden="true"
				>
					✍️
				</div>
			)
		}
		<div class="flex flex-1 flex-col p-6">
			<div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-muted">
				<time datetime={date.toISOString()}>{formatDate(date, lang)}</time>
			</div>
			<h3 class="mt-3 font-display text-lg font-bold leading-8 transition-colors group-hover:text-accent">{title}</h3>
			{excerpt && <p class="mt-2 line-clamp-3 flex-1 text-sm leading-7 text-muted">{excerpt}</p>}
			{
				categories.length > 0 && (
					<div class="mt-5 flex flex-wrap gap-2">
						{categories.slice(0, 3).map((category) => (
							<span class="chip">{category}</span>
						))}
					</div>
				)
			}
		</div>
	</a>
</article>
