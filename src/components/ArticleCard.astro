---
import { formatDate, type Lang } from "../i18n/ui"
import { articlesSource } from "../lib/articles"

interface Props {
	lang: Lang
	title: string
	link: string
	date: Date
	excerpt?: string
	image?: string
	categories?: string[]
}
const { lang, title, link, date, excerpt, image, categories = [] } = Astro.props
const source = articlesSource(lang)
---

<article
	class="reveal card card-hover card-rule group h-full overflow-hidden"
	data-article-card
	data-categories={JSON.stringify(categories)}
>
	<a href={link} target="_blank" rel="noopener noreferrer" class="flex h-full flex-col">
		{
			image && (
				<img
					src={image}
					alt=""
					loading="lazy"
					decoding="async"
					width="640"
					height="360"
					referrerpolicy="no-referrer"
					class="card-media"
				/>
			)
		}
		<div class="flex flex-1 flex-col p-6">
			<div class="mono flex items-center justify-between gap-3 text-[11px] text-muted">
				<time datetime={date.toISOString()}>{formatDate(date, lang)}</time>
				<span class="transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:text-accent" aria-hidden="true">↗</span>
			</div>
			<h3 class="serif mt-3 text-lg font-semibold leading-8 transition-colors group-hover:text-accent">{title}</h3>
			{excerpt && <p class="clamp-3 mt-2.5 flex-1 text-sm leading-7 text-muted">{excerpt}</p>}
			<div class="mt-5 flex flex-wrap items-center justify-between gap-2 border-t border-line pt-4">
				<div class="flex flex-wrap gap-1.5">
					{categories.slice(0, 3).map((category) => <span class="chip">{category}</span>)}
				</div>
				{source && <span class="text-[11px] text-muted">{source}</span>}
			</div>
		</div>
	</a>
</article>
