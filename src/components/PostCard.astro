---
import { formatDate, t, localePath, type Lang } from "../i18n/ui"

interface Props {
	lang: Lang
	slug: string
	title: string
	description?: string
	date: Date
	tags?: string[]
	cover?: string
	minutes?: number
}
const { lang, slug, title, description, date, tags = [], cover, minutes } = Astro.props
const tr = t(lang)
const href = localePath(lang, `/blog/${slug}`)
---

<article class="reveal card card-hover card-rule group h-full overflow-hidden">
	<a href={href} class="flex h-full flex-col">
		{
			cover ? (
				<img
					src={cover}
					alt=""
					loading="lazy"
					decoding="async"
					width="640"
					height="360"
					class="card-media"
				/>
			) : (
				<div class="card-media-fallback" aria-hidden="true">
					“”
				</div>
			)
		}
		<div class="flex flex-1 flex-col p-6">
			<div class="mono flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] text-muted">
				<time datetime={date.toISOString()}>{formatDate(date, lang)}</time>
				{minutes && <span>· {minutes} {tr("blog.min")}</span>}
			</div>
			<h3 class="serif mt-3 text-lg font-semibold leading-8 transition-colors group-hover:text-accent">{title}</h3>
			{description && <p class="clamp-3 mt-2 flex-1 text-sm leading-7 text-muted">{description}</p>}
			{
				tags.length > 0 && (
					<div class="mt-5 flex flex-wrap gap-2">
						{tags.slice(0, 3).map((tag) => (
							<span class="chip">#{tag}</span>
						))}
					</div>
				)
			}
		</div>
	</a>
</article>
