---
import { t, localePath, type Lang } from "../i18n/ui"
import settings from "../data/settings.json"
import profileFa from "../data/profile.fa.json"
import profileEn from "../data/profile.en.json"

interface Props {
	lang: Lang
}
const { lang } = Astro.props
const tr = t(lang)
const profile = lang === "en" ? profileEn : profileFa
const year = new Date().getFullYear()
---

<footer class="site-footer">
	<div class="wrap">
		<p class="footer-word" aria-hidden="true">{profile.name}</p>
		<div class="mt-10 flex flex-col items-start justify-between gap-6 border-t border-line pt-8 md:flex-row md:items-center">
			<p class="mono text-xs text-muted">© {year} {profile.name} — {tr("footer.rights")}</p>
			<div class="flex flex-wrap items-center gap-x-6 gap-y-3">
				{
					settings.social.map((s) => (
						<a href={s.url} target="_blank" rel="noopener noreferrer me" class="footer-link">
							{s.label}
						</a>
					))
				}
				<a href={`${import.meta.env.BASE_URL}rss.xml`} class="footer-link">RSS</a>
				<a href={localePath(lang, "/blog")} class="footer-link">{tr("nav.blog")}</a>
			</div>
		</div>
	</div>
</footer>
